# Global settings template

# Redis settings — an external Redis you provide (not bundled by compose).
# Use its real host/IP; both the containers and the watcher reach it the same way.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Camera — RTSP URL (or webcam index). configs/*.yaml reference this as
# ${CAMERA_URI} so credentials stay out of the tracked config files.
CAMERA_URI=rtsp://user:pass@camera-host:554/Streaming/Channels/101

# LLM settings — any OpenAI-compatible endpoint (cloud or custom)
LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL_NAME=your-vision-model
# Which OpenAI protocol: "chat" (Chat Completions, default) or "responses" (Responses API)
LLM_API_MODE=chat

# Local vLLM (optional; only used by `docker compose --profile local up`)
VLLM_PORT=8000

# Play the alert beep on a rule violation (host runs only; containers set this
# to false since they have no audio output).
ALERT_SOUND_ENABLED=true

# UI / prompt language: zh (default) or en
APP_LANG=zh
